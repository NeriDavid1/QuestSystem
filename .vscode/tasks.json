{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "editor:dev",
      "type": "npm",
      "script": "dev",
      "path": "editor",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:\\s+http://localhost:\\d+"
        }
      }
    }
  ]
}
