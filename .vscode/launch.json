{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QuestForge Editor",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/editor",
      "preLaunchTask": "editor:dev"
    },
    {
      "name": "Unity → YAML (unity_to_yaml)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/unity_to_yaml.py",
      "args": [
        "--unity-root",
        "C:\\Users\\123ne\\source\\repos\\Animal-English-World\\English Kingdom\\Assets\\_OurAssets"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Validate Unity sync (validate_unity_sync)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/validate_unity_sync.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build seed bundle (import_yaml_to_supabase)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/import_yaml_to_supabase.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Rebuild all (build_all)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_all.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
